# Modelo para o banco remoto. COPIE para `.env.aiven` e preencha lá.
#
#     cp .env.aiven.example .env.aiven
#
# `.env.aiven` é ignorado pelo Git (`.env.*` no .gitignore da raiz) e serve a
# um propósito só: rodar as migrations contra o banco do Aiven SEM tocar no
# `.env` do ambiente local.
#
#     php artisan migrate --force --env=aiven
#     php artisan db:seed --class=CategoriaSeeder --env=aiven
#
# Trocar o `.env` de lugar e devolver depois funcionaria — até a vez em que
# alguém esquecesse de devolver e rodasse uma migration no banco errado.
#
# Os valores saem do painel do Aiven, em Service → Connection information.
# Não cole nenhum deles em conversa, issue ou commit.

APP_ENV=production
APP_DEBUG=false

# A mesma chave do serviço no Render. `php artisan key:generate --show`.
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# O Aiven recusa conexão sem TLS. Baixe o "CA certificate" no painel e aponte
# o caminho completo do arquivo na sua máquina — ele também não vai para o Git.
MYSQL_ATTR_SSL_CA=

# Nenhum destes é usado pelas migrations, mas o Laravel os lê ao subir.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
