APP_NAME="Controle Financeiro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==========================================================================
# EM PRODUÇÃO, MUDE ESTES TRÊS
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://seu-dominio
#
# APP_DEBUG=false não é preferência: com ele ligado, qualquer erro 500 devolve
# a mensagem original da exceção, o caminho absoluto do arquivo no servidor e o
# stack trace completo dentro do JSON. Com ele desligado, a mesma falha vira
# {"message": "Server Error"}.
#
# Gere a APP_KEY antes do primeiro deploy:  php artisan key:generate
# ==========================================================================

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Em produção use `warning` ou `error`: `debug` grava dados de requisição.
LOG_LEVEL=debug

# --------------------------------------------------------------- Banco
# O produto roda em MariaDB/MySQL. A suíte de testes usa SQLite em memória,
# configurado no phpunit.xml — não altere aqui por causa dos testes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=controle_gastos
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------ Frontend
# Origens autorizadas a chamar a API, separadas por vírgula. SEM ISTO O
# FRONTEND EM PRODUÇÃO É BLOQUEADO PELO NAVEGADOR: o padrão só libera o
# servidor de desenvolvimento do Vite.
#   Exemplo: CORS_ALLOWED_ORIGINS=https://app.seu-dominio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------- Autenticação
# Validade do token de API, em minutos. Padrão: 7 dias.
SANCTUM_TOKEN_EXPIRATION=10080

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# O limitador de tentativas de senha guarda o contador aqui. Em mais de uma
# instância, use um store compartilhado (redis) — com `database` ou `file`
# cada instância conta separado.
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"
