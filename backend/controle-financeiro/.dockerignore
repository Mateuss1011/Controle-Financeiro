# O que NÃO entra na imagem.
#
# No Render o contexto vem de um clone do git, então boa parte disto já não
# estaria lá. O arquivo existe para o build local: sem ele, um `docker build`
# na máquina de desenvolvimento copiaria o `.env` com a senha do banco para
# dentro da imagem.

# Segredos — nunca, em hipótese alguma.
.env
.env.*
!.env.example

# Reinstalado pelo composer dentro do build, com --no-dev.
vendor/

# Nada de Node aqui: o frontend é outro projeto e outro deploy.
node_modules/
package.json
package-lock.json
vite.config.js

.git/
.github/

# Testes não rodam em produção. O vendor de produção nem tem phpunit.
tests/
phpunit.xml
.phpunit.result.cache
.phpunit.cache/

# Gerados em tempo de execução. Os diretórios continuam existindo porque cada
# um tem seu .gitignore versionado — é o conteúdo que fica de fora.
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Ferramentas e lixo de sistema.
.idea/
.vscode/
.DS_Store
Thumbs.db
*.sql
*.dump
